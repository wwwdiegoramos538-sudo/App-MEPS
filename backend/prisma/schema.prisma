generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  USER
  ADMIN
}

enum SubscriptionPlan {
  FREE
  BASIC
  PRO
  ENTERPRISE
}

enum SubscriptionStatus {
  ACTIVE
  CANCELLED
  EXPIRED
  TRIAL
}

enum TranslationStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
}

enum DocumentType {
  PDF
  DOCX
  TXT
  OTHER
}

enum PaymentStatus {
  PENDING
  COMPLETED
  FAILED
  REFUNDED
}

model User {
  id            String    @id @default(uuid())
  email         String    @unique
  password      String
  name          String
  avatar        String?
  role          UserRole  @default(USER)
  isActive      Boolean   @default(true)
  emailVerified Boolean   @default(false)
  resetToken    String?
  resetExpires  DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  subscription Subscription?
  documents    Document[]
  translations Translation[]
  payments     Payment[]
  audiobooks   Audiobook[]
  designs      Design[]
  chatMessages ChatMessage[]
  libraryItems LibraryItem[]

  @@map("users")
}

model Subscription {
  id                   String             @id @default(uuid())
  userId               String             @unique
  user                 User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  plan                 SubscriptionPlan   @default(FREE)
  status               SubscriptionStatus @default(ACTIVE)
  stripeCustomerId     String?
  stripeSubscriptionId String?
  currentPeriodStart   DateTime?
  currentPeriodEnd     DateTime?
  translationsLimit    Int                @default(5)
  translationsUsed     Int                @default(0)
  createdAt            DateTime           @default(now())
  updatedAt            DateTime           @updatedAt

  payments Payment[]

  @@map("subscriptions")
}

model Document {
  id           String       @id @default(uuid())
  userId       String
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  title        String
  originalName String
  fileName     String
  filePath     String
  fileSize     Int
  mimeType     String
  type         DocumentType
  pageCount    Int?
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  translations Translation[]
  libraryItems LibraryItem[]

  @@index([userId])
  @@map("documents")
}

model Translation {
  id              String            @id @default(uuid())
  userId          String
  user            User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  documentId      String?
  document        Document?         @relation(fields: [documentId], references: [id], onDelete: SetNull)
  sourceLanguage  String
  targetLanguage  String
  sourceText      String?           @db.Text
  translatedText  String?           @db.Text
  originalFile    String?
  translatedFile  String?
  provider        String            @default("deepl")
  status          TranslationStatus @default(PENDING)
  wordCount       Int?
  processingTime  Int?
  errorMessage    String?           @db.Text
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  @@index([userId])
  @@index([status])
  @@map("translations")
}

model Payment {
  id              String        @id @default(uuid())
  userId          String
  user            User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  subscriptionId  String?
  subscription    Subscription? @relation(fields: [subscriptionId], references: [id], onDelete: SetNull)
  amount          Float
  currency        String        @default("USD")
  status          PaymentStatus @default(PENDING)
  stripePaymentId String?
  stripeInvoiceId String?
  description     String?
  createdAt       DateTime      @default(now())

  @@index([userId])
  @@map("payments")
}

model Audiobook {
  id           String   @id @default(uuid())
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  title        String
  sourceText   String   @db.Text
  audioPath    String?
  voice        String   @default("alloy")
  language     String
  duration     Int?
  status       String   @default("pending")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([userId])
  @@map("audiobooks")
}

model Design {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  title     String
  type      String   @default("cover")
  template  String?
  content   Json
  thumbnail String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@map("designs")
}

model LibraryItem {
  id         String    @id @default(uuid())
  userId     String
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  documentId String?
  document   Document? @relation(fields: [documentId], references: [id], onDelete: SetNull)
  title      String
  category   String    @default("general")
  tags       String[]
  isFavorite Boolean   @default(false)
  createdAt  DateTime  @default(now())

  @@index([userId])
  @@map("library_items")
}

model ChatMessage {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  message   String   @db.Text
  isSupport Boolean  @default(false)
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([userId])
  @@map("chat_messages")
}

model AdminLog {
  id        String   @id @default(uuid())
  adminId   String
  action    String
  target    String?
  details   Json?
  ipAddress String?
  createdAt DateTime @default(now())

  @@index([adminId])
  @@map("admin_logs")
}
